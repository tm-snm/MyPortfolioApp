<%# locals: (id:, title:, value:, description:, link_path: nil, link_label: nil) %>

<div class="col-12 col-sm-6">
  <section id="<%= id %>" class="card creation-surface h-100">
    <div class="card-body d-flex flex-column">
      <h3 class="h6"><%= title %></h3>
      <p class="dashboard-metric-value display-6 fw-semibold mb-2"><%= value %></p>
      <p class="small creation-muted mb-0"><%= description %></p>

      <% if link_path.present? %>
        <div class="mt-auto pt-2">
          <%= link_to link_label, link_path, class: "dashboard-link" %>
        </div>
      <% end %>
    </div>
  </section>
</div>
