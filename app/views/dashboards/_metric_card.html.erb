<div class="col-12 col-sm-6 col-xl-3">
  <section id="<%= id %>" class="card h-100 shadow-sm">
    <div class="card-body d-flex flex-column">
      <h2 class="h6 text-secondary"><%= title %></h2>
      <p class="dashboard-metric-value display-6 fw-semibold mb-2">
        <%= value %>
      </p>
      <p class="small text-muted mb-3"><%= description %></p>

      <% if link_path.present? %>
        <div class="mt-auto">
          <%= link_to link_label,
                      link_path,
                      class: "stretched-link link-primary small" %>
        </div>
      <% end %>
    </div>
  </section>
</div>
