<div class="container py-4">
  <div class="mb-4">
    <h1 class="h2"><%= @prompt_template.title %></h1>

    <p class="text-muted">
      <%= @prompt_template.description %>
    </p>
  </div>

  <div class="card shadow-sm mb-3" data-controller="clipboard">
    <div class="card-body">
      <h2 class="h5 mb-3">プロンプト本文</h2>

      <pre
        class="mb-3"
        data-clipboard-target="source"><%= @prompt_template.body %></pre>

      <div class="d-flex align-items-center gap-3">
        <button
          type="button"
          class="btn btn-outline-primary btn-sm"
          data-action="clipboard#copy">
          コピーする
        </button>

        <span
          class="text-success small"
          data-clipboard-target="message">
        </span>
      </div>
    </div>
  </div>

  <div class="d-flex gap-2">
    <%= link_to "テンプレート一覧へ戻る",
                prompt_templates_path,
                class: "btn btn-outline-secondary" %>

    <%= link_to "カードを作成",
                new_card_path,
                class: "btn btn-primary" %>
  </div>
</div>