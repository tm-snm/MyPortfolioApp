<div class="container creation-page py-4 py-md-5">
  <div class="mb-4">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
      <% if @prompt_template.official? %>
        <span class="badge text-bg-primary">公式</span>
      <% else %>
        <span class="badge text-bg-success">個人</span>
      <% end %>

      <span class="badge text-bg-light border text-dark break-anywhere">
        <%= @prompt_template.category %>
      </span>
    </div>

    <h1 class="creation-heading break-anywhere"><%= @prompt_template.title %></h1>

    <% if @prompt_template.description.present? %>
      <p class="creation-muted mb-0 break-anywhere">
        <%= @prompt_template.description %>
      </p>
    <% end %>
  </div>

  <section
    class="creation-surface p-3 p-md-4 mb-3"
    aria-labelledby="use-template-heading"
    data-controller="clipboard"
    data-clipboard-usage-url-value="<%= record_usage_prompt_template_path(@prompt_template) %>">
    <h2 id="use-template-heading" class="h5 mb-3">このテンプレートを使う</h2>

    <div class="d-grid d-sm-flex align-items-sm-center gap-2 gap-sm-3 mb-3">
      <button
        type="button"
        class="btn btn-primary"
        hidden
        data-clipboard-target="button"
        data-action="clipboard#copy">
        プロンプトをコピー
      </button>

      <span
        class="small break-anywhere"
        data-clipboard-target="message"
        role="status"
        aria-live="polite">
      </span>
    </div>

    <p class="creation-muted mb-1">
      コピーしたプロンプトを普段使っている外部AIに貼り付けます。
      整理された回答をコピーしてRecall Cardに戻ってください。
    </p>
    <%= link_to "AI回答を貼り付ける", new_from_ai_cards_path, class: "mobile-link mb-2" %>

    <details class="creation-disclosure" data-clipboard-target="manualPanel">
      <summary>プロンプト本文</summary>
      <pre class="prompt-template-content mb-0"
           data-clipboard-target="source"><%= @prompt_template.body %></pre>
    </details>

    <noscript>
      <p class="form-text mb-0">プロンプト本文を開き、選択して手動でコピーしてください。</p>
    </noscript>
  </section>

  <div class="d-grid d-sm-flex flex-sm-wrap gap-2">
    <%= render "favorite_button",
               prompt_template: @prompt_template,
               favorite: @favorite %>

    <% unless @prompt_template.official? %>
      <%= link_to "編集",
                  edit_prompt_template_path(@prompt_template),
                  class: "btn btn-outline-primary" %>

      <%= button_to "個人テンプレートを削除",
                    prompt_template_path(@prompt_template),
                    method: :delete,
                    data: {
                      turbo_confirm: "この個人テンプレートを削除しますか？",
                      turbo_submits_with: "削除中..."
                    },
                    class: "btn btn-outline-danger",
                    form: {
                      class: "d-grid"
                    } %>
    <% end %>

    <%= link_to "テンプレート一覧へ戻る",
                prompt_templates_path,
                class: "btn btn-outline-secondary" %>
  </div>
</div>
