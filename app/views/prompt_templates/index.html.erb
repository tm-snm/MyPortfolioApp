<div class="container py-4">
  <div class="d-flex flex-column flex-sm-row justify-content-sm-between align-items-sm-start gap-3 mb-4">
    <div>
      <h1 class="h2 break-anywhere">プロンプトテンプレート</h1>
      <p class="text-muted mb-0">
        公式テンプレートまたは自分専用のテンプレートを選んで、AIとの会話をRecall Card用に整理できます。
      </p>
    </div>

    <div class="d-grid d-sm-block flex-shrink-0">
      <%= link_to "個人テンプレートを作成",
                  new_prompt_template_path,
                  class: "btn btn-primary" %>
    </div>
  </div>

  <section class="card shadow-sm mb-4" aria-labelledby="quick-access-heading">
    <div class="card-body">
      <h2 id="quick-access-heading" class="h4 mb-3">クイックアクセス</h2>

      <div class="row g-4">
        <div class="col-12 col-lg-6" id="favorite-templates">
          <h3 class="h5">お気に入り</h3>

          <% if @favorite_prompt_templates.any? %>
            <div class="list-group">
              <% @favorite_prompt_templates.each do |prompt_template| %>
                <%= link_to prompt_template_path(prompt_template),
                            class: "list-group-item list-group-item-action" do %>
                  <span class="d-flex flex-wrap align-items-center gap-2">
                    <span class="break-anywhere"><%= prompt_template.title %></span>
                    <span class="badge <%= prompt_template.official? ? 'text-bg-primary' : 'text-bg-success' %>">
                      <%= prompt_template.official? ? "公式" : "個人" %>
                    </span>
                  </span>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted mb-0">お気に入りはまだありません。</p>
          <% end %>
        </div>

        <div class="col-12 col-lg-6" id="recent-templates">
          <h3 class="h5">最近使ったテンプレート</h3>

          <% if @recent_prompt_templates.any? %>
            <div class="list-group">
              <% @recent_prompt_templates.each do |prompt_template| %>
                <%= link_to prompt_template_path(prompt_template),
                            class: "list-group-item list-group-item-action" do %>
                  <span class="d-flex flex-wrap align-items-center gap-2">
                    <span class="break-anywhere"><%= prompt_template.title %></span>
                    <span class="badge <%= prompt_template.official? ? 'text-bg-primary' : 'text-bg-success' %>">
                      <%= prompt_template.official? ? "公式" : "個人" %>
                    </span>
                  </span>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted mb-0">
              テンプレートをコピーすると、ここからすぐに開けます。
            </p>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <h2 class="h4 mb-3">すべてのテンプレート</h2>

  <% if @prompt_templates.any? %>
    <div class="row g-3">
      <% @prompt_templates.each do |prompt_template| %>
        <div class="col-12 col-md-6">
          <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
              <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <% if prompt_template.official? %>
                  <span class="badge text-bg-primary">公式</span>
                <% else %>
                  <span class="badge text-bg-success">個人</span>
                <% end %>

                <span class="badge text-bg-light border text-dark break-anywhere">
                  <%= prompt_template.category %>
                </span>
              </div>

              <h2 class="h5 card-title break-anywhere">
                <%= prompt_template.title %>
              </h2>

              <% if prompt_template.description.present? %>
                <p class="card-text text-muted break-anywhere">
                  <%= prompt_template.description %>
                </p>
              <% end %>

              <div class="d-grid d-sm-flex flex-sm-wrap gap-2 mt-auto">
                <%= link_to "詳細を見る",
                            prompt_template_path(prompt_template),
                            class: "btn btn-outline-primary" %>

                <%= render "favorite_button",
                           prompt_template: prompt_template,
                           favorite: @favorite_prompt_template_ids.include?(
                             prompt_template.id
                           ) %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center border rounded p-3 p-sm-5 bg-light">
      <p class="mb-3">利用できるテンプレートがありません。</p>
      <%= link_to "個人テンプレートを作成",
                  new_prompt_template_path,
                  class: "btn btn-primary" %>
    </div>
  <% end %>

  <div class="d-grid d-sm-block mt-4">
    <%= link_to "カード一覧へ戻る",
                cards_path,
                class: "btn btn-outline-secondary" %>
  </div>
</div>
