<%= form_with model: prompt_template do |form| %>
  <%= render "shared/form_errors", record: prompt_template, id: "prompt-template-errors" %>

  <div class="mb-3">
    <%= form.label :title, "タイトル", class: "form-label" %>
    <%= form.text_field :title,
                        class: "form-control",
                        placeholder: "例：エラー調査用テンプレート",
                        **field_error_attributes(prompt_template, :title, error_id: "prompt-template-errors") %>
  </div>

  <div class="mb-3">
    <%= form.label :category, "カテゴリー", class: "form-label" %>
    <%= form.text_field :category,
                        class: "form-control",
                        placeholder: "例：技術調査",
                        **field_error_attributes(prompt_template, :category, error_id: "prompt-template-errors") %>
  </div>

  <div class="mb-3">
    <%= form.label :description, "説明（任意）", class: "form-label" %>
    <%= form.text_area :description,
                       rows: 3,
                       class: "form-control",
                       placeholder: "どのような場面で使うテンプレートかを入力してください" %>
  </div>

  <div class="mb-4">
    <%= form.label :body, "プロンプト本文", class: "form-label" %>
    <%= form.text_area :body,
                       rows: 16,
                       class: "form-control",
                       placeholder: "外部AIへコピーして使うプロンプトを入力してください",
                        **field_error_attributes(prompt_template, :body, error_id: "prompt-template-errors") %>
  </div>

  <div class="d-grid d-sm-block">
    <% submit_label =
         prompt_template.persisted? ? "個人テンプレートを更新" : "個人テンプレートを作成" %>
    <%= form.submit submit_label, class: "btn btn-primary",
                    data: { turbo_submits_with: "保存中..." } %>
  </div>
<% end %>
