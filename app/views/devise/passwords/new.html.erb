<div class="container creation-page account-page auth-page py-4 py-md-5">
  <section class="creation-surface p-3 p-md-4">
    <h1 class="creation-heading mb-3">パスワードの再設定</h1>
    <p class="creation-muted">登録したメールアドレスを入力してください。</p>

    <%= form_for resource, as: resource_name, url: password_path(resource_name),
                 html: { method: :post },
                 data: account_form_submission_data(validation_error_id: "error_explanation", handle_server_errors: false) do |f| %>
      <%= render "devise/shared/submission_feedback",
                 message: "再設定メールの送信結果を確認できませんでした。受信箱と迷惑メールフォルダーを確認し、届いていない場合は時間をおいてもう一度お試しください。" %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-3">
        <%= f.label :email, "メールアドレス", class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control",
                          **field_error_attributes(resource, :email, error_id: "error_explanation") %>
      </div>

      <div class="d-grid">
        <%= f.submit "再設定メールを送信", class: "btn btn-primary",
                     data: { turbo_submits_with: "送信中…" } %>
      </div>
    <% end %>

    <div class="mt-3"><%= render "devise/shared/links" %></div>
  </section>
</div>
