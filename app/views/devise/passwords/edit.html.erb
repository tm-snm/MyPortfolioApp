<div class="container creation-page account-page auth-page py-4 py-md-5">
  <section class="creation-surface p-3 p-md-4">
    <h1 class="creation-heading mb-3">新しいパスワードを設定</h1>

    <% if resource.errors[:reset_password_token].any? %>
      <p class="alert alert-danger" role="alert" tabindex="-1" data-controller="focus">
        このリンクでは再設定できません。
      </p>
    <% else %>
      <%= form_for resource, as: resource_name, url: password_path(resource_name),
                   html: { method: :put },
                   data: account_form_submission_data(validation_error_id: "error_explanation") do |f| %>
        <%= render "devise/shared/submission_feedback",
                   message: "パスワードの変更結果を確認できませんでした。別タブでは、ログイン済みの場合はカード一覧、未ログインの場合はログイン画面が開きます。ログイン画面が開いたら、新しいパスワードでログインできるか確認してください。",
                   recovery_label: "ログイン状態を確認する（別タブ）", recovery_path: cards_path %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div class="mb-3">
          <%= f.label :password, "新しいパスワード", class: "form-label" %>
          <% if @minimum_password_length %>
            <p id="reset-password-help" class="form-text"><%= @minimum_password_length %>文字以上で入力してください。</p>
          <% end %>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control",
                               data: { form_submission_target: "resetOnFailure" },
                               **field_error_attributes(resource, :password, error_id: "error_explanation",
                                                        description_id: ("reset-password-help" if @minimum_password_length)) %>
        </div>

        <div class="mb-3">
          <%= f.label :password_confirmation, "新しいパスワード（確認）", class: "form-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control",
                               data: { form_submission_target: "resetOnFailure" },
                               **field_error_attributes(resource, :password_confirmation, error_id: "error_explanation") %>
        </div>

        <div class="d-grid">
          <%= f.submit "パスワードを変更", class: "btn btn-primary",
                       data: { turbo_submits_with: "変更中…" } %>
        </div>
      <% end %>
    <% end %>

    <div class="mt-3">
      <%= link_to "再設定メールをもう一度リクエストする", new_password_path(resource_name), class: "mobile-link" %>
      <%= render "devise/shared/links" %>
    </div>
  </section>
</div>
