<div class="container creation-page account-page auth-page py-4 py-md-5">
  <section class="creation-surface p-3 p-md-4">
    <h1 class="creation-heading mb-4">ログイン</h1>

    <%= form_for(
          resource,
          as: resource_name,
          url: session_path(resource_name)
        ) do |f| %>

      <div class="mb-3">
        <%= f.label :email, "メールアドレス",
                    class: "form-label" %>
        <%= f.email_field :email,
                          autofocus: true,
                          autocomplete: "email",
                          class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :password, "パスワード",
                    class: "form-label" %>
        <%= f.password_field :password,
                             autocomplete: "current-password",
                             class: "form-control" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="form-check mb-4">
          <%= f.check_box :remember_me,
                          class: "form-check-input" %>
          <%= f.label :remember_me,
                      "ログイン状態を保持する",
                      class: "form-check-label" %>
        </div>
      <% end %>

      <div class="d-grid">
        <%= f.submit "ログイン",
                     class: "btn btn-primary",
                     data: { turbo_submits_with: "ログイン中…" } %>
      </div>
    <% end %>

    <div class="mt-3">
      <%= render "devise/shared/links" %>
    </div>
  </section>
</div>
