<nav class="d-flex flex-column align-items-start gap-1" aria-label="認証の関連リンク">
  <% if controller_name != "sessions" %>
    <%= link_to "ログインはこちら", new_session_path(resource_name), class: "mobile-link" %>
  <% end %>

  <% if devise_mapping.recoverable? && controller_name != "passwords" %>
    <%= link_to "パスワードを忘れた方はこちら", new_password_path(resource_name), class: "mobile-link" %>
  <% end %>

  <% if devise_mapping.registerable? && controller_name != "registrations" %>
    <%= link_to "新規登録はこちら", new_registration_path(resource_name), class: "mobile-link" %>
  <% end %>
</nav>
