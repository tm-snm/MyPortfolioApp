<header class="site-header"
        <% if user_signed_in? %>
          data-controller="site-navigation"
          data-action="keydown.esc->site-navigation#close"
        <% end %>>
  <div class="site-header-inner">
    <%= link_to "Recall Card", root_path, class: "site-brand" %>

    <% if user_signed_in? %>
      <button class="btn btn-outline-secondary site-menu-toggle"
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#main-navbar"
              data-site-navigation-target="toggle"
              aria-controls="main-navbar"
              aria-expanded="false">
        メニュー
      </button>

      <div class="collapse site-menu"
           id="main-navbar"
           data-site-navigation-target="menu"
           data-action="turbo:click->site-navigation#focusDestination">
        <nav class="site-primary-nav" aria-label="メインナビゲーション">
          <%= navigation_link "カード一覧", cards_path, :cards, exact: action_name == "index" %>
          <%= navigation_link "今日の復習", cards_path(review_filter: "due"), :review, exact: true %>
          <%= navigation_link "プロンプト", prompt_templates_path, :prompts, exact: action_name == "index" %>
          <%= navigation_link "ダッシュボード", dashboard_path, :dashboard, exact: true %>
        </nav>

        <%= navigation_link "AI回答を貼り付ける", new_from_ai_cards_path, :create_card,
                            exact: action_name == "new_from_ai",
                            classes: "btn site-create-link" %>

        <details class="site-account" <%= "open" if current_navigation_item == :account %>>
          <summary class="site-nav-link">アカウント</summary>
          <p class="mb-1 small break-anywhere"><%= current_user.email %></p>
          <%= link_to "アカウント設定", edit_user_registration_path, class: "site-nav-link",
                      aria: { current: ("page" if controller_path == "users/registrations") } %>
          <%= button_to "ログアウト", destroy_user_session_path, method: :delete,
                        class: "site-nav-link",
                        data: { turbo_submits_with: "ログアウト中..." },
                        form: { class: "m-0" } %>
          <%= link_to "アカウント削除", account_deletion_path, class: "site-nav-link site-danger-link",
                      aria: { current: ("page" if controller_path == "account_deletions") } %>
        </details>

        <button type="button"
                class="btn btn-outline-secondary site-menu-close"
                data-action="site-navigation#close">
          メニューを閉じる
        </button>
      </div>
    <% else %>
      <nav class="d-flex flex-wrap justify-content-end gap-2" aria-label="メインナビゲーション">
        <%= link_to "ログイン", new_user_session_path, class: "btn btn-outline-primary btn-sm" %>
        <%= link_to "新規登録", new_user_registration_path, class: "btn btn-primary btn-sm" %>
      </nav>
    <% end %>
  </div>
</header>
