<% flash.each do |type, message| %>
  <% bootstrap_class =
       case type.to_sym
       when :notice
         "success"
       when :alert
         "danger"
       else
         "info"
       end %>

  <div class="container mt-3" data-turbo-temporary>
    <div
      class="alert alert-<%= bootstrap_class %> alert-dismissible fade show"
      id="flash-<%= type %>"
      role="alert"
      <% if type.to_sym == :alert && controller.response.status == 422 %>
        tabindex="-1" data-controller="focus"
      <% end %>
    >
      <span class="d-block break-anywhere pe-2"><%= message %></span>

      <button
        type="button"
        class="btn-close"
        data-bs-dismiss="alert"
        aria-label="閉じる"
      ></button>
    </div>
  </div>
<% end %>