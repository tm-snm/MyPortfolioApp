<div class="container py-4">
  <div class="mb-4">
    <h1 class="h2"><%= @card.title %></h1>

    <div class="text-muted">
      作成日時:
      <%= @card.created_at.strftime("%Y/%m/%d %H:%M") %>
    </div>
  </div>

  <% if @card.tags.any? %>
    <div class="mb-3">
      <h2 class="h5">タグ</h2>

      <div class="d-flex flex-wrap gap-2">
        <% @card.tags.each do |tag| %>
          <span class="badge text-bg-secondary">
            <%= tag.name %>
          </span>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="mb-4">
    <h2 class="h5">ステータス</h2>

    <% if @card.review_later? %>
      <span class="badge text-bg-warning">
        復習予定
      </span>
    <% else %>
      <span class="badge text-bg-secondary">
        通常
      </span>
    <% end %>
  </div>

  <div class="mb-4">
    <h2 class="h5">本文</h2>

    <div>
      <%= simple_format(@card.body) %>
    </div>
  </div>

  <% if @card.future_note.present? %>
    <div class="mb-4">
      <h2 class="h5">未来の自分へのメモ</h2>

      <div>
        <%= simple_format(@card.future_note) %>
      </div>
    </div>
  <% end %>

  <div class="d-flex gap-2">
    <%= link_to "編集", edit_card_path(@card), class: "btn btn-outline-primary" %>
    <%= button_to "削除", card_path(@card), method: :delete, data: { turbo_confirm: "このカードを削除しますか？" }, class: "btn btn-outline-danger" %>
    <%= link_to "カード一覧へ戻る", cards_path, class: "btn btn-outline-secondary" %>
    <% if @card.review_later? %>
      <%= button_to "復習予定を解除",
                    card_path(@card),
                    method: :patch,
                    params: {
                      card: {
                        status: "normal"
                      }
                    },
                    class: "btn btn-outline-secondary" %>
    <% else %>
      <%= button_to "復習予定にする",
                    card_path(@card),
                    method: :patch,
                    params: {
                      card: {
                        status: "review_later"
                      }
                    },
                    class: "btn btn-outline-warning" %>
    <% end %>
  </div>
</div>