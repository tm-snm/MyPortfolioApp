<% form_url = @previewed ? cards_path : preview_from_ai_cards_path %>
<% frame_target = @previewed ? "_top" : "ai_card_builder" %>
<%# This form posts to both create and preview after parsing, including without Turbo. %>
<% shared_csrf_token = form_authenticity_token if @previewed %>

<%= form_with model: @card,
              url: form_url,
              method: :post,
              authenticity_token: shared_csrf_token,
              class: "creation-surface p-3 p-md-4",
              data: {
                turbo_frame: frame_target,
                controller: "form-submission",
                form_submission_sign_in_path_value: new_user_session_path,
                action: [
                  "turbo:submit-start->form-submission#start",
                  "turbo:submit-end->form-submission#end",
                  "turbo:before-fetch-response->form-submission#preserveOnServerError",
                  "turbo:fetch-request-error->form-submission#requestFailed",
                  "turbo:frame-missing@document->form-submission#handleMissingFrame"
                ].join(" ")
              } do |f| %>
  <% if @previewed %>
    <%= hidden_field_tag :ai_previewed, "1" %>
  <% elsif @tag_names.present? %>
    <%= hidden_field_tag :tag_names, @tag_names %>
  <% end %>

  <div class="alert alert-warning" role="alert" hidden data-form-submission-target="networkError">
    送信結果を確認できませんでした。入力は残っています。
    <% if @previewed %>
      保存を送信した場合は、再試行する前に
      <%= link_to "カード一覧を別のタブで開き", cards_path, target: "_blank", rel: "noopener" %>、結果を確認してください。
    <% else %>
      通信状況を確認して再試行してください。
    <% end %>
  </div>

  <%= render "shared/form_errors", record: @card, id: "ai-card-errors" %>

  <% if @previewed %>
    <h2 id="parsed-card-heading" class="h5 mb-3" tabindex="-1"
        <% if @show_markdown_preview %>data-controller="focus"<% end %>>カード内容を確認・編集する</h2>

    <div class="mb-3">
      <%= f.label :title, "タイトル", class: "form-label" %>
      <%= f.text_field :title, class: "form-control",
                           **field_error_attributes(@card, :title, error_id: "ai-card-errors") %>
    </div>

    <div class="mb-3">
      <%= f.label :body, "本文", class: "form-label" %>
      <%= f.text_area :body, rows: 10, class: "form-control",
                           **field_error_attributes(@card, :body, error_id: "ai-card-errors") %>
    </div>

    <%= tag.details class: "creation-disclosure mb-3", open: @card.future_note.present? do %>
      <summary>未来の自分へのメモ（任意）</summary>
      <%= f.label :future_note, "未来の自分へのメモ", class: "visually-hidden" %>
      <%= f.text_area :future_note, rows: 3, class: "form-control" %>
    <% end %>

    <%= render "tag_input",
               available_tags: @available_tags,
               tag_names_value: @tag_names,
               collapse_candidates: true %>

    <div class="d-grid d-sm-flex mb-3">
      <%= f.submit "カードを保存",
                   class: "btn btn-primary",
                   data: { turbo_submits_with: "保存中..." } %>
    </div>

    <%= tag.details class: "creation-disclosure", open: @raw_content_error.present? do %>
      <summary>貼り付けたAI回答と再解析</summary>
      <%= render "ai_raw_content_fields", form: f %>

      <p class="form-text">
        原文の変更を編集欄に反映するには、再解析してください。
        再解析で本文と抽出できたタイトルを置き換え、メモとタグは残します。
      </p>

      <div class="d-grid d-sm-flex">
        <%= f.submit "貼り付け内容を再解析",
                     formaction: preview_from_ai_cards_path,
                     class: "btn btn-outline-primary",
                     data: {
                       turbo_frame: "ai_card_builder",
                       turbo_submits_with: "解析中..."
                     } %>
      </div>
    <% end %>

    <% if @show_markdown_preview %>
      <details class="creation-disclosure mt-2">
        <summary>解析時点の表示プレビュー</summary>
        <p class="form-text">編集後のMarkdown表示は、保存後のカード詳細で確認できます。</p>
        <div class="markdown-content min-w-0">
          <%= render_markdown(@card.body) %>
        </div>
      </details>
    <% end %>
  <% else %>
    <h2 class="h5 mb-3">AI回答を貼り付ける</h2>
    <%= render "ai_raw_content_fields", form: f %>

    <div class="d-grid d-sm-flex">
      <%= f.submit "内容を確認",
                   class: "btn btn-primary",
                   data: { turbo_submits_with: "解析中..." } %>
    </div>

    <div class="d-flex flex-wrap column-gap-3 mt-2">
      <%= link_to "テンプレートを選ぶ", prompt_templates_path, class: "mobile-link" %>
      <%= link_to "手入力でカードを作成", new_card_path, class: "mobile-link" %>
    </div>
  <% end %>
<% end %>
