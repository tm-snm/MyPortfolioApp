<div class="mb-3">
  <%= form.label :raw_content, "AIの出力", class: "form-label" %>

  <%= form.text_area :raw_content,
                     rows: 10,
                     class: "form-control#{' is-invalid' if @raw_content_error.present?}",
                     aria: {
                       invalid: @raw_content_error.present?,
                       describedby: "raw-content-help"
                     },
                     placeholder: "【タイトル】\n解決した内容のタイトル\n\n【本文】\n原因や解決方法\n\n【未来の自分へのメモ】\n次回確認すること" %>

  <% if @raw_content_error.present? %>
    <div id="raw-content-help" class="invalid-feedback" role="alert"
         tabindex="-1" data-controller="focus"><%= @raw_content_error %></div>
  <% else %>
    <div id="raw-content-help" class="form-text">
      形式が異なる場合も、全文を本文として確認・編集できます。
    </div>
  <% end %>
</div>
