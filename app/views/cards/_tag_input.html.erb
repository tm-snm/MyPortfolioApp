<%
  serialized_tag_names = tag_names_value.to_s
  selected_tag_names = serialized_tag_names
                         .split(",")
                         .map(&:strip)
                         .reject(&:blank?)
                         .uniq
%>

<div class="mb-3"
     data-controller="tag-input"
     data-action="submit@document->tag-input#prepareSubmit">
  <%= label_tag :tag_names, "タグ", class: "form-label" %>

  <div class="input-group">
    <%= text_field_tag :tag_names,
                       serialized_tag_names,
                       class: "form-control",
                       placeholder: "例：Rails",
                       autocomplete: "off",
                       data: {
                         tag_input_target: "input",
                         action: "keydown->tag-input#handleKeydown"
                       } %>

    <%= button_tag "追加",
                   type: "button",
                   class: "btn btn-outline-primary",
                   data: { action: "tag-input#add" } %>
  </div>

  <div class="form-text">
    候補を選ぶか、タグ名を入力してEnterまたは「追加」を押してください。
  </div>

  <div class="mt-3">
    <h3 class="h6 mb-2">選択中のタグ</h3>

    <p class="text-muted small mb-2<%= ' d-none' if selected_tag_names.any? %>"
       data-tag-input-target="emptyState">
      選択中のタグはありません。
    </p>

    <div class="d-flex flex-wrap gap-2"
         aria-live="polite"
         data-tag-input-target="selectedList">
      <% selected_tag_names.each do |tag_name| %>
        <span class="badge rounded-pill text-bg-secondary tag-badge d-inline-flex align-items-center gap-2">
          <span><%= tag_name %></span>

          <button type="button"
                  class="btn-close btn-close-white"
                  aria-label="<%= "#{tag_name}を選択から外す" %>"
                  data-tag-name="<%= tag_name %>"
                  data-action="tag-input#remove"></button>
        </span>
      <% end %>
    </div>
  </div>

  <div class="mt-3">
    <h3 class="h6 mb-2">過去に使用したタグ</h3>

    <% if available_tags.any? %>
      <div class="d-flex flex-wrap gap-2">
        <% available_tags.each do |tag| %>
          <% selected = selected_tag_names.include?(tag.name) %>

          <button type="button"
                  class="btn btn-sm btn-outline-secondary tag-badge"
                  aria-pressed="<%= selected %>"
                  <%= "disabled" if selected %>
                  data-tag-input-target="candidate"
                  data-tag-name="<%= tag.name %>"
                  data-action="tag-input#selectCandidate">
            <%= tag.name %>
          </button>
        <% end %>
      </div>
    <% else %>
      <p class="text-muted small mb-0">
        まだ再利用できるタグはありません。
      </p>
    <% end %>
  </div>
</div>
