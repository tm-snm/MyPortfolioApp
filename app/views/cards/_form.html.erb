<%= form_with model: card do |form| %>
  <% if card.errors.any? %>
    <div class="alert alert-danger">
      <p class="mb-2">
        入力内容に<%= card.errors.count %>件のエラーがあります。
      </p>

      <ul class="mb-0">
        <% card.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :title, "タイトル", class: "form-label" %>
    <%= form.text_field :title, class: "form-control", placeholder: "例：DockerでGemを追加できなかった原因" %>
  </div>

  <div class="mb-3">
    <%= form.label :body, "本文", class: "form-label" %>
    <%= form.text_area :body, rows: 12, class: "form-control", placeholder: "状況、原因、解決方法などを入力してください" %>
  </div>

  <div class="mb-4">
    <%= form.label :future_note, "未来の自分へのメモ", class: "form-label" %>

    <%= form.text_area :future_note, rows: 4, class: "form-control", placeholder: "次回まず確認することなどを入力してください" %>
  </div>

  <div class="mb-3">
    <%= label_tag :tag_names, "タグ", class: "form-label" %>

    <%= text_field_tag :tag_names,
                      params[:tag_names].presence || card.tags.map(&:name).join(", "),
                      class: "form-control",
                      placeholder: "Rails, Docker, GitHub" %>

    <div class="form-text">
      複数のタグはカンマ区切りで入力してください。
    </div>
  </div>

  <div class="d-flex gap-2">
    <% submit_label = card.persisted? ? "カードを更新" : "カードを作成" %>
    <%= form.submit submit_label, class: "btn btn-primary" %>
  </div>
<% end %>
