<%= form_with model: card do |form| %>
  <%= render "shared/form_errors", record: card, id: "card-errors" %>

  <div class="mb-3">
    <%= form.label :title, "タイトル", class: "form-label" %>
    <%= form.text_field :title, class: "form-control", placeholder: "例：DockerでGemを追加できなかった原因",
                        **field_error_attributes(card, :title, error_id: "card-errors") %>
  </div>

  <div class="mb-3">
    <%= form.label :body, "本文", class: "form-label" %>
    <%= form.text_area :body, rows: 12, class: "form-control", placeholder: "状況、原因、解決方法などを入力してください",
                        **field_error_attributes(card, :body, error_id: "card-errors") %>
  </div>

  <div class="mb-4">
    <%= form.label :future_note, "未来の自分へのメモ", class: "form-label" %>

    <%= form.text_area :future_note, rows: 4, class: "form-control", placeholder: "次回まず確認することなどを入力してください" %>
  </div>

  <% tag_names_value =
       if params.key?(:tag_names)
         params[:tag_names]
       else
         card.tags.map(&:name).join(", ")
       end %>

  <%= render "tag_input",
             available_tags: @available_tags,
             tag_names_value: tag_names_value %>

  <div class="d-grid d-sm-flex gap-2">
    <% submit_label = card.persisted? ? "カードを更新" : "カードを保存" %>
    <%= form.submit submit_label, class: "btn btn-primary",
                    data: { turbo_submits_with: "保存中..." } %>
  </div>
<% end %>
