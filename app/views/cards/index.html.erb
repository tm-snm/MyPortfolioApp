<div class="container py-4">
  <% review_filter_labels = {
       "all" => "復習予定すべて",
       "due" => "今日までに復習",
       "today" => "今日復習",
       "this_week" => "今週復習",
       "overdue" => "期限超過"
     } %>
  <% filtering_active = params[:q].present? || params[:tag_id].present? || @review_filter.present? %>
  <% conditions_active = filtering_active ||
                         @search_target != "all" ||
                         @sort_order != "newest" %>

  <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
    <h1 class="h2 mb-0">カード一覧</h1>

    <div class="d-grid d-sm-block">
      <%= link_to "AI出力からカードを作成",
                  new_from_ai_cards_path,
                  class: "btn btn-primary flex-shrink-0" %>
    </div>
  </div>

  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <%= form_with url: cards_path,
                    method: :get,
                    class: "row g-2 align-items-end" do %>

        <div class="col-12 col-lg-4"
             data-controller="card-title-autocomplete"
             data-card-title-autocomplete-url-value="<%= autocomplete_cards_path %>"
             data-card-title-autocomplete-delay-value="250">
          <%= label_tag :q, "キーワード", class: "form-label" %>

          <div class="position-relative">
            <%= search_field_tag :q,
                                 params[:q],
                                 placeholder: "カードを検索",
                                 class: "form-control",
                                 autocomplete: "off",
                                 role: "combobox",
                                 aria: {
                                   autocomplete: "list",
                                   controls: "card-title-autocomplete-list",
                                   expanded: "false"
                                 },
                                 data: {
                                   card_title_autocomplete_target: "input",
                                   action: [
                                     "input->card-title-autocomplete#search",
                                     "compositionend->card-title-autocomplete#search",
                                     "keydown->card-title-autocomplete#handleKeydown",
                                     "blur->card-title-autocomplete#handleBlur"
                                   ].join(" ")
                                 } %>

            <div id="card-title-autocomplete-list"
                 class="autocomplete-list list-group position-absolute top-100 start-0 w-100 d-none"
                 role="listbox"
                 data-card-title-autocomplete-target="list"></div>
          </div>

          <p class="visually-hidden mb-0"
             aria-live="polite"
             data-card-title-autocomplete-target="status"></p>
        </div>

        <div class="col-12 col-md-6 col-lg-2">
          <%= label_tag :search_target, "検索対象", class: "form-label" %>

          <%= select_tag :search_target,
                         options_for_select(
                           [["すべて", "all"], ["タイトル", "title"], ["本文", "body"]],
                           @search_target
                         ),
                         class: "form-select" %>
        </div>

        <div class="col-12 col-md-6 col-lg-2">
          <%= label_tag :tag_id, "タグ", class: "form-label" %>

          <%= select_tag :tag_id,
                        options_from_collection_for_select(
                          @tags,
                          :id,
                          :name,
                          params[:tag_id]
                        ),
                        include_blank: "すべてのタグ",
                        class: "form-select" %>
        </div>

        <div class="col-12 col-md-6 col-lg-2">
          <%= label_tag :review_filter, "復習状況", class: "form-label" %>

          <%= select_tag :review_filter,
                         options_for_select(
                           [
                             ["すべてのカード", ""],
                             ["復習予定すべて", "all"],
                             ["今日まで", "due"],
                             ["今日", "today"],
                             ["今週", "this_week"],
                             ["期限超過", "overdue"]
                           ],
                           @review_filter.to_s
                         ),
                         class: "form-select" %>
        </div>

        <div class="col-12 col-md-6 col-lg-2">
          <%= label_tag :sort, "並び順", class: "form-label" %>

          <%= select_tag :sort,
                         options_for_select(
                           [["新しい順", "newest"], ["古い順", "oldest"]],
                           @sort_order
                         ),
                         class: "form-select" %>
        </div>

        <div class="col-12 col-lg-auto">
          <div class="d-grid d-sm-flex gap-2">
            <%= submit_tag "絞り込む",
                          class: "btn btn-outline-primary" %>

            <% if conditions_active %>
              <%= link_to "条件を解除",
                          cards_path,
                          class: "btn btn-outline-secondary" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <% if @review_filter.present? %>
    <div class="alert alert-warning py-2 mb-4">
      <%= review_filter_labels.fetch(@review_filter) %>のカードを表示しています。
    </div>
  <% end %>

  <% if @cards.any? %>
    <div class="row g-3">
      <% @cards.each do |card| %>
        <div class="col-12">
          <article class="card shadow-sm">
            <div class="card-body">
              <div class="d-flex flex-column flex-md-row justify-content-between gap-2">
                <div class="min-w-0">
                  <h2 class="h5 card-title break-anywhere mb-2">
                    <%= card.title %>
                  </h2>

                  <p class="text-muted small mb-0">
                    作成日時：
                    <%= card.created_at.strftime("%Y/%m/%d %H:%M") %>
                  </p>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                  <%= link_to "詳細を見る",
                              card_path(card),
                              class: "btn btn-outline-primary btn-sm" %>

                  <%= render "review_status", card: card %>
                </div>
              </div>
            </div>
          </article>
        </div>
      <% end %>
    </div>
  <% elsif filtering_active %>
    <div class="text-center border rounded p-3 p-sm-5 bg-light">
      <p class="mb-3">
        条件に一致するカードが見つかりませんでした。
      </p>

      <%= link_to "条件を解除",
                  cards_path,
                  class: "btn btn-outline-secondary" %>
    </div>

  <% else %>
    <div class="text-center border rounded p-3 p-sm-5 bg-light">
      <p class="mb-2">まだカードがありません。</p>

      <p class="text-muted mb-3">
        AIで解決した内容を最初のカードとして残してみましょう。
      </p>

      <%= link_to "最初のカードを作成するプロンプトを選ぶ",
                  prompt_templates_path,
                  class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
