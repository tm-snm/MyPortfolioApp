#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "json"

# Digests identify the already-public values from commit 881c8a6.
# These are one-way fingerprints, not decryption keys or secret_key_base values.
module RuntimeCredentialsAudit
  EXPOSED_KEY_DIGEST = "86ad5bc012a152e0cf1d7d5e777e26407a4e6217511f1d6acb0f8aca1c5b9e1c"
  EXPOSED_SECRET_DIGEST = "3ad18c4a2a87a1582a8a8d6a389e5984446385ded876ed50b78b5144f5236af2"

  def self.report(application:, environment:)
    credentials = application.credentials
    key = credentials.key.to_s.strip
    credential_secret = credentials.secret_key_base.to_s
    effective_secret = application.secret_key_base.to_s

    {
      key_required: application.config.require_master_key,
      credentials_readable: !credential_secret.empty?,
      explicit_secret_override: !environment.fetch("SECRET_KEY_BASE", "").to_s.empty?,
      effective_secret_from_credentials: !credential_secret.empty? && effective_secret == credential_secret,
      decryption_key_matches_exposed: Digest::SHA256.hexdigest(key) == EXPOSED_KEY_DIGEST,
      credentials_secret_matches_exposed: Digest::SHA256.hexdigest(credential_secret) == EXPOSED_SECRET_DIGEST,
      effective_secret_matches_exposed: Digest::SHA256.hexdigest(effective_secret) == EXPOSED_SECRET_DIGEST
    }
  end

  def self.safe?(report)
    report[:key_required] && report[:credentials_readable] &&
      report[:effective_secret_from_credentials] && !report[:explicit_secret_override] &&
      !report[:decryption_key_matches_exposed] && !report[:credentials_secret_matches_exposed] &&
      !report[:effective_secret_matches_exposed]
  end
end

if $PROGRAM_NAME == __FILE__
  begin
    require File.expand_path("config/environment", Dir.pwd)
    report = RuntimeCredentialsAudit.report(application: Rails.application, environment: ENV)
    puts JSON.generate(report)
    exit(RuntimeCredentialsAudit.safe?(report) ? 0 : 1)
  rescue StandardError
    warn "Runtime credentials audit failed. Secret values suppressed."
    exit 1
  end
end
