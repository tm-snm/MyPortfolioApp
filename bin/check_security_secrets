#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "json"
require "open3"
require "tmpdir"

# Scanner stdout/stderr and report contents may contain secrets, even on failure.
# Only an explicit metadata allowlist is emitted. Never publish the raw report.
root = File.expand_path("..", __dir__)
scanner = ENV.fetch("GITLEAKS_BIN", "gitleaks")
config = File.join(root, ".gitleaks.toml")
ignore = File.join(root, ".gitleaksignore")
failed = false

Dir.mktmpdir("recall-card-secret-scan-") do |directory|
  source = File.join(directory, "source")
  FileUtils.mkdir_p(source)
  paths, status = Open3.capture2("git", "-C", root, "ls-files", "-c", "-o", "--exclude-standard", "-z")
  abort "Unable to inventory source files." unless status.success?

  paths.split("\0").uniq.each do |path|
    original = File.join(root, path)
    next unless File.file?(original)
    abort "Symlink source requires manual review." if File.symlink?(original)
    target = File.join(source, path)
    FileUtils.mkdir_p(File.dirname(target))
    FileUtils.copy_file(original, target)
  end

  [ [ "git", root, "history" ], [ "dir", source, "source" ] ].each do |mode, target, label|
    report = File.join(directory, "#{label}.json")
    arguments = [
      scanner, mode, target, "--config", config, "--gitleaks-ignore-path", ignore,
      "--redact=100", "--no-banner", "--no-color", "--report-format=json",
      "--report-path", report
    ]
    arguments << "--log-opts=--all" if mode == "git"
    _output, result = Open3.capture2e(*arguments, chdir: root)
    begin
      findings = File.exist?(report) ? JSON.parse(File.read(report)) : nil
    rescue JSON::ParserError
      warn "#{label}: invalid scanner report; raw contents suppressed."
      failed = true
      next
    end

    unless [ 0, 1 ].include?(result.exitstatus) && findings.is_a?(Array)
      warn "#{label}: scanner failed; raw diagnostics suppressed."
      failed = true
      next
    end

    puts "#{label}: #{findings.length} finding(s)"
    findings.each do |finding|
      puts JSON.generate(finding.slice("RuleID", "File", "StartLine", "Commit", "Fingerprint"))
    end
    failed ||= !result.success? || findings.any?
  end
end

exit(failed ? 1 : 0)
