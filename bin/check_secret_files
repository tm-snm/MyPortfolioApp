#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"

# Inspect paths only: never read or print the contents of secret files.
tracked, status = Open3.capture2("git", "ls-files", "-z")
abort "Could not inspect Git-tracked files." unless status.success?

secret_paths = tracked.split("\0").select do |path|
  path == "config/master.key" ||
    (path.start_with?("config/credentials/") && path.end_with?(".key"))
end

unless secret_paths.empty?
  warn "Rails decryption keys must not be tracked:"
  secret_paths.each { |path| warn path.inspect }
  exit 1
end

samples = %w[config/master.key config/credentials/production.key config/credentials/development.key]
ignored, status = Open3.capture2("git", "check-ignore", "--no-index", "--stdin", stdin_data: samples.join("\n") + "\n")
abort "Could not inspect Git ignore rules." unless [ 0, 1 ].include?(status.exitstatus)

unless (samples - ignored.lines.map(&:chomp)).empty?
  abort "Git ignore rules must exclude Rails decryption keys."
end

puts "Rails decryption keys are untracked and ignored."
